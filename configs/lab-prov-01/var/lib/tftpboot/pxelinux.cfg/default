# ============================================================================
#  TechCore :: pxelinux.cfg/default :: режим SAFE (первый живой тест)
#  Читает: pxelinux.0 в RAM загружаемой ВМ (НЕ dnsmasq, НЕ Apache).
#  Пути относительные от tftp-root=/var/lib/tftpboot, все в нижнем регистре.
#  Собрано под syslinux 4.04-alt18: меню через PROMPT, без зависимости от menu.c32.
#  Параметры ядра/initrd взяты из isolinux.cfg самого ISO (источник истины).
# ============================================================================

DEFAULT local
PROMPT 1
TIMEOUT 300
ONTIMEOUT local

LABEL local
    MENU LABEL Boot from local disk
    LOCALBOOT 0

LABEL install-alt-p10
    MENU LABEL Install ALT Linux p10 Server
    KERNEL alt-p10/vmlinuz
    APPEND initrd=alt-p10/initrd.img stagename=altinst ramdisk_size=786432 vga=normal
