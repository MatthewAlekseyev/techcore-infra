DEFAULT install-alt-p10
PROMPT 0
TIMEOUT 50
ONTIMEOUT install-alt-p10

LABEL install-alt-p10
    KERNEL alt-p10/vmlinuz
    APPEND initrd=alt-p10/initrd.img fastboot changedisk automatic=method:http,network:dhcp,server:192.168.100.10,directory:/alt-p10 stagename=altinst ramdisk_size=514073 showopts vga=normal mpath lowmem ai curl=http://192.168.100.10/kickstarts
    IPAPPEND 2

LABEL local
    LOCALBOOT 0
