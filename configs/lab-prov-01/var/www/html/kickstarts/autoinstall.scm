("/sysconfig-base/language" language ("en_US") action "write" lang ("en_US"))
("/sysconfig-base/kbd" language ("en_US") action "write" layout "")
("/datetime-installer" language ("en_US") action "write" commit #t name "Europe" zone "Europe/Moscow" utc #t ctime "set automatically")
("/evms/control" language ("en_US") action "write" control open installer #t)
("/evms/control" language ("en_US") action "write" control update)
("/evms/profiles/server" language ("en_US") action apply commit #f clearall #t exclude ())
("/evms/control" language ("en_US") action "write" control update)
("/evms/control" language ("en_US") action "write" control commit)
("/evms/control" language ("en_US") action "write" control update)
("/evms/control" language ("en_US") action "write" control close)
("/remount-destination" language ("en_US") action "write")
("pkg-init" language ("en_US") action "write")
("/pkg-size" language ("en_US") action "write" lists "zt")
("/pkg-install" language ("en_US") action "write" lists "zt" auto #t)
("/preinstall" language ("en_US") action "write")
("/grub" language ("en_US") action "write" device "/dev/sda" passwd #f passwd_1 "*" passwd_2 "*")
("/net-eth" language ("en_US") action "write" reset #t)
("/net-eth" language ("en_US") action "write" name "enp0s3" ipv "4" ipv_enabled #t controlled "etcnet" configuration "dhcp" default "" search "" dns "" computer_name "zt-node")
("/net-eth" language ("en_US") action "write" commit #t)
("/root/change_password" language ("en_US") passwd_1 "techcore123" passwd_2 "techcore123")
("/users/create_account" language ("en_US") new_name "localadm" gecos "localadm" allow_su #t auto #f passwd_1 "techcore123" passwd_2 "techcore123" autologin #f)
("/postinstall/laststate" script "http://192.168.100.10/kickstarts/trigger.sh")
